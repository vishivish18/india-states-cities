{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2019",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@vishivish18/india-states-cities": [
        "./src/index.ts"
      ],
      "@vishivish18/india-states-cities/react": [
        "./src/react.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "demo/src"
  ]
}
